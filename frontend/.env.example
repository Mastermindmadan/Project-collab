# ============================================================
# Frontend Environment Variables — ProjectCollab AI
# Copy this file to .env and fill in your actual values
# ============================================================

# The full URL of your Render backend (NO trailing slash, NO /api)
# Example: https://projectcollab-ai-backend.onrender.com
VITE_API_URL="https://your-render-backend.onrender.com/api"

# Socket.io server URL — same as backend host (without /api)
VITE_SOCKET_URL="https://your-render-backend.onrender.com"
