# ============================================================
# Frontend Environment Variables — ProjectCollab AI
# Copy this file to .env and fill in your actual values
# ============================================================

# The full URL of your Render backend (NO trailing slash).
VITE_API_URL="https://project-collab-fvp4.onrender.com/api"

# Socket.io server URL — same as backend host (without /api). Defaults to
# /socket.io path, which is what the backend uses.
VITE_SOCKET_URL="https://project-collab-fvp4.onrender.com"
