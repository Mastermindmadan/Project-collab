# PostgreSQL configuration (Supabase)
# Replace the placeholder with your Supabase connection string.
# Example format:
# postgresql://<USER>:<PASSWORD>@<PROJECT_REF>.supabase.co:5432/postgres?schema=public

DATABASE_URL=""

# Comma-separated frontend origins allowed to call this API (CORS + Socket.io)
# Local dev default if unset: http://localhost:5173,http://localhost:3000,...
# ALLOWED_ORIGINS="http://localhost:5173,https://your-app.vercel.app"
