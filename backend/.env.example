# ============================================================
# Backend Environment Variables — ProjectCollab AI
# Copy this file to .env and fill in your actual values
# NEVER commit the real .env file to Git
# ============================================================

# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────
# On Render (production), use the SESSION POOLER URL (port 6543):
DATABASE_URL="postgresql://postgres.<your-project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# For migrations (Prisma migrate), use DIRECT connection (port 5432):
DIRECT_URL="postgresql://postgres:<your-project-ref>:<password>@db.<your-project-ref>.supabase.co:5432/postgres"

# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
# Comma-separated PRODUCTION origins only — local dev origins (localhost:5173,
# localhost:3000, 127.0.0.1) are always allowed by src/config/cors.ts.
ALLOWED_ORIGINS="https://your-frontend.vercel.app,https://your-custom-domain.com"
FRONTEND_URL="https://your-frontend.vercel.app"

# ─── Authentication ────────────────────────────────────────────────────────
# Use long random strings in production (e.g. openssl rand -base64 64)
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"

# ─── Google Gemini AI ──────────────────────────────────────────────────────
# Comma-separated list for multi-key failover (get from https://aistudio.google.com/apikey)
GEMINI_API_KEYS="key1,key2"
GEMINI_API_KEY="key1"
GEMINI_MODEL="gemini-3.6-flash"

# ─── Groq AI (Secondary) ───────────────────────────────────────────────────
# Groq uses OpenAI-compatible chat completions at api.groq.com.
GROQ_API_KEY="gsk_your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"

# ─── OpenAI AI (Optional tertiary provider) ────────────────────────────────
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# ─── GitHub API (Optional server-side fallback token) ──────────────────────
GITHUB_TOKEN="ghp_your-github-token"

# ─── Cloudinary ────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Email SMTP (Optional — for password reset emails) ────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="ProjectCollab AI <no-reply@projectcollab.ai>"
