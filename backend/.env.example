# ============================================================
# Backend Environment Variables — ProjectCollab AI
# Copy this file to .env and fill in your actual values
# NEVER commit the real .env file to Git
# ============================================================

# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────
# On Render (production), use the SESSION POOLER URL (port 6543):
DATABASE_URL="postgresql://postgres.<your-project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# For migrations (Prisma migrate), use DIRECT connection (port 5432):
DIRECT_URL="postgresql://postgres:<your-project-ref>:<password>@db.<your-project-ref>.supabase.co:5432/postgres"

# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
# Comma-separated PRODUCTION origins only — local dev origins (localhost:5173,
# localhost:3000, 127.0.0.1) are always allowed by src/config/cors.ts.
ALLOWED_ORIGINS="https://project-collab-one.vercel.app,http://localhost:5173,http://localhost:3000"
FRONTEND_URL="https://project-collab-one.vercel.app"

# Optional: resilience for transient Supabase pooler blips. The Prisma client
# retries connection-level errors (P1001, P1002, P1008, ECONNRESET, etc.) up to
# DB_CONN_RETRY_ATTEMPTS times with exponential backoff (base delay ms) before
# surfacing the error. Defaults below; only set these if you want to tune them.
# DB_CONN_RETRY_ATTEMPTS=3
# DB_CONN_RETRY_BASE_DELAY_MS=200

# ─── Authentication ────────────────────────────────────────────────────────
# Use long random strings in production (e.g. openssl rand -base64 64)
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"

# ─── Google Gemini AI ──────────────────────────────────────────────────────
# Comma-separated list for multi-key failover (get from https://aistudio.google.com/apikey)
GEMINI_API_KEYS="key1,key2"
GEMINI_API_KEY="key1"
GEMINI_MODEL="gemini-3.6-flash"

# ─── Groq AI (Secondary) ───────────────────────────────────────────────────
# Groq uses OpenAI-compatible chat completions at api.groq.com.
GROQ_API_KEY="gsk_your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"

# ─── OpenAI AI (Optional tertiary provider) ────────────────────────────────
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# ─── GitHub API (Optional server-side fallback token) ──────────────────────
GITHUB_TOKEN="ghp_your-github-token"

# ─── Deployment Intelligence (Vercel + Render) ─────────────────────────────
# Read-only server-side calls to the Vercel and Render public APIs. These tokens
# are NEVER exposed to the frontend — every request goes through the backend.
#   Vercel:    token from https://vercel.com/account/tokens
#   Vercel:    project id from the Vercel dashboard (Settings → General → Project ID, prj_...)
#   Render:    API key from https://dashboard.render.com/account/api-keys  (rnd_...)
#   Render:    service id from the Render dashboard (Service → Settings → Service ID, srv_...)
VERCEL_TOKEN="your-vercel-token"
VERCEL_PROJECT_ID="prj_your-vercel-project-id"
RENDER_API_KEY="rnd_your-render-api-key"
RENDER_SERVICE_ID="srv_your-render-service-id"
# Provider API base overrides — FOR MOCK-PROVIDER E2E TESTING ONLY (dummy
# Vercel/Render accounts, see src/scripts/verify-deploy-intelligence-e2e.ts).
# Leave unset for normal dev/production — defaults are https://api.vercel.com
# and https://api.render.com/v1.
# VERCEL_API_BASE="http://localhost:8899"
# RENDER_API_BASE="http://localhost:8899"

# ─── Cloudinary ────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Email Brevo (Primary — for password reset emails) ─────────────────────
# Brevo v3 API key (xkeysib-... format) from https://app.brevo.com/settings/keys/api
# (API keys tab — NOT the SMTP tab). Sender defaults to the verified address
# madansudharshan@gmail.com; override with BREVO_SENDER if needed.
BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER="madansudharshan@gmail.com"
BREVO_SENDER_NAME="ProjectCollab AI"

# ─── Email SMTP (Optional — legacy rollback path, unused) ──────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="ProjectCollab AI <no-reply@projectcollab.ai>"
